sw:VASP6.5.4 a emmo:EMMO_8681074a_e225_4e38_b586_e85b0f43ce38 ;
    dcterms:description "Electronic structure calculations with DFT"@en ;
    dcterms:title "VASP 6.5.4"@en ;
