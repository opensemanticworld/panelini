{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://oo-ld.org/latest/meta/oold-meta-schema-base.json",
  "$dynamicAnchor": "meta",
  "title": "OO-LD dialect meta-schema (body)",
  "$comment": "The dialect body: the standard 2020-12 vocabularies plus the x-oold-* keyword syntax.",
  "allOf": [
    {
      "$ref": "https://json-schema.org/draft/2020-12/schema"
    },
    {
      "$ref": "https://oo-ld.org/latest/meta/oold-ui-meta-schema.json#keywords"
    }
  ],
  "properties": {
    "@context": {
      "description": "JSON-LD context for instances of this schema.",
      "anyOf": [
        {
          "type": "object"
        },
        {
          "type": "string",
          "format": "iri-reference"
        },
        {
          "type": "array",
          "items": {
            "anyOf": [
              {
                "type": "object"
              },
              {
                "type": "string",
                "format": "iri-reference"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "x-oold-context": {
      "description": "Extended term mappings (synonyms).",
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": {
          "type": [
            "object",
            "null"
          ],
          "properties": {
            "x-oold-sssom": {
              "type": "object",
              "properties": {
                "predicate_id": {
                  "type": "string",
                  "default": "skos:exactMatch"
                },
                "mapping_set_id": {
                  "oneOf": [
                    {
                      "type": "string",
                      "format": "iri-reference"
                    },
                    {
                      "type": "array",
                      "items": {
                        "type": "string",
                        "format": "iri-reference"
                      }
                    }
                  ]
                }
              }
            }
          }
        }
      }
    },
    "x-oold-sssom": {
      "description": "Schema-level ontology correspondences.",
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "predicate_id": {
            "type": "string",
            "default": "skos:exactMatch"
          },
          "mapping_set_id": {
            "oneOf": [
              {
                "type": "string",
                "format": "iri-reference"
              },
              {
                "type": "array",
                "items": {
                  "type": "string",
                  "format": "iri-reference"
                }
              }
            ]
          }
        }
      }
    },
    "x-oold-uuid": {
      "description": "Stable UUID identifying this schema.",
      "type": "string",
      "format": "uuid"
    },
    "x-oold-version": {
      "description": "Semantic version of this schema.",
      "type": "string"
    },
    "x-oold-prior-version": {
      "description": "Identifier or version of the preceding schema version.",
      "type": "string"
    },
    "x-oold-backward-compatible-with": {
      "type": "string",
      "format": "uri-reference"
    },
    "x-oold-incompatible-with": {
      "type": "string",
      "format": "uri-reference"
    },
    "x-oold-instance-rdf-type": {
      "description": "The rdf:type(s) carried by instances of this schema.",
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "x-oold-ref": {
      "description": "Reference to another OO-LD schema.",
      "type": "string",
      "format": "uri-reference"
    },
    "x-oold-range": {
      "description": "Type constraint on the target of an IRI-valued property.",
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        {
          "type": "object"
        }
      ]
    },
    "x-oold-multilang-title": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "x-oold-multilang-description": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "x-oold-reverse-properties": {
      "type": "object"
    },
    "x-oold-reverse-required": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "x-oold-reverse-default-properties": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "x-enum-varnames": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "x-enum-descriptions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
