    foaf:name "European Comission"^^xsd:string .

chameo:ElectronProbeMicroanalysis a owl:Class ;
    rdfs:label "Electron Probe Microanalysis"@en ;
    rdfs:subClassOf chameo:Microscopy ;
    skos:altLabel "EMPA"@en ;
    emmo:EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9 "Electron probe microanalysis (EPMA) is used for quantitative analysis of the elemental composition of solid specimens at a micrometer scale. The method uses bombardment of the specimen by keV electrons to excite characteristic X-rays from the sample, which are then detected by using wavelength-dispersive (WD) spectrometers."@en .

chameo:SynchrotronXRayDiffraction a owl:Class ;
    rdfs:label "Synchrotron X-ray Diffraction"@en ;
    rdfs:subClassOf chameo:ScatteringAndDiffraction ;
    skos:altLabel "SXRD"@en ;
    emmo:EMMO_967080e5_2f42_4eb2_a3a9_c58143e835f9 "A high-resolution material characterization technique that measures the scattering of high-intensity, coherent, and tunable X-ray beam - generated by a synchrotron particle accelerator - as they interact with a crystalline or semi-crystalline sample. The resulting diffraction patterns are analyzed to determine the precise three-dimensional atomic structure, phase composition, and structural dynamics of materials with superior spatial and temporal resolution compared to conventional laboratory X-ray sources."@en .

