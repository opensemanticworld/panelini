temgo:BackscatteredElectronImaging a owl:Class ;
    rdfs:label "Backscattered Electron Imaging"@en ;
    rdfs:subClassOf chameo:ScanningElectronMicroscopy ;
    skos:altLabel "BSE"@en ;
    emmo:elucidation "Image formed by incident beam electrons that are elastically deflected back out of the sample."@en .

temgo:BrightFieldImaging a owl:Class ;
    rdfs:label "Bright Field Imaging"@en ;
    rdfs:subClassOf chameo:TransmissionElectronMicroscopy ;
    skos:altLabel "BF"@en .

temgo:ConvergentBeamElectronDiffraction a owl:Class ;
    rdfs:label "Convergen tBeam Electron Diffraction"@en ;
    rdfs:subClassOf chameo:TransmissionElectronMicroscopy ;
    skos:altLabel "CBED"@en .

temgo:DarkFieldImaging a owl:Class ;
    rdfs:label "Dark Field Imaging"@en ;
    rdfs:subClassOf chameo:TransmissionElectronMicroscopy ;
    skos:altLabel "DF"@en .

temgo:EDSMapping a owl:Class ;
    rdfs:label "EDS Mapping"@en ;
    rdfs:subClassOf chameo:TransmissionElectronMicroscopy .

temgo:EELSMapping a owl:Class ;
    rdfs:label "EELS Mapping"@en ;
    rdfs:subClassOf chameo:TransmissionElectronMicroscopy .

temgo:ElectronEnergyLossSpectroscopy a owl:Class ;
    rdfs:label "Electron Energy Loss Spectroscopy"@en ;
    rdfs:subClassOf chameo:Spectroscopy ;
    skos:altLabel "EELS"@en .

temgo:HighAngleAnnularDarkField a owl:Class ;
    rdfs:label "High-Angle Annular Dark-Field"@en ;
    rdfs:subClassOf temgo:AnnularDarkField ;
    skos:altLabel "HAADF"@en ;
    emmo:elucidation "ADF with typical collection angle of 50-200 mrad. Pure atomic-number (Z-contrast), where intensity scales roughly with \\(Z^{1.4}\\) to Z² (heavy elements shine brighter)."@en .

temgo:HighResolutionTransmissionElectronMicroscopy a owl:Class ;
    rdfs:label "High-Resolution Transmission Electron Microscopy"@en ;
    rdfs:subClassOf chameo:TransmissionElectronMicroscopy ;
    skos:altLabel "HRTEM"@en .

temgo:LowAngleAnnularDarkField a owl:Class ;
    rdfs:label "Low-Angle Annular Dark Field"@en ;
    rdfs:subClassOf temgo:AnnularDarkField ;
    skos:altLabel "LAADF"@en ;
    emmo:elucidation "ADF with typical collection angle of 25-60 mrad. Strongly affected by elastic scattering, diffraction contrast, and local strain/defects."@en .

temgo:MediumAngleAnnularDarkField a owl:Class ;
    rdfs:label "Medium-Angle Annular Dark Field"@en ;
    rdfs:subClassOf temgo:AnnularDarkField ;
    skos:altLabel "MAADF"@en ;
    emmo:elucidation "ADF with typical collection angle of 30-100 mrad. Blends atomic-number (Z) sensitivity with partial diffraction and intermediate scattering effects."@en .

temgo:NanoBeamDiffractionScanningTransmissionElectronMicroscopy a owl:Class ;
    rdfs:label "Nano-Beam Diffraction STEM"@en ;
    rdfs:subClassOf chameo:NanoBeamDiffraction ;
    skos:altLabel "NBD STEM"@en,
        "NBDSTEM"@en ;
    emmo:elucidation "Nano-Beam Diffraction (NBD) combined with STEM to acquire local electron diffraction patterns."@en .

temgo:ScanningPrecessionElectronDiffraction a owl:Class ;
    rdfs:label "Scanning Precession Electron Diffraction"@en ;
    rdfs:subClassOf chameo:PrecisionElectronDiffraction ;
    skos:altLabel "SPED"@en .

temgo:ScanningTransmissionElectronMicroscopy a owl:Class ;
    rdfs:label "Scanning Transmission Electron Microscopy"@en ;
    rdfs:subClassOf chameo:TransmissionElectronMicroscopy ;
    skos:altLabel "STEM"@en .

temgo:SecondaryElectronImaging a owl:Class ;
    rdfs:label "Secondary Electron Imaging"@en ;
    rdfs:subClassOf chameo:ScanningElectronMicroscopy ;
    skos:altLabel "SE"@en ;
    emmo:elucidation "Image formed by outer-shell electrons ejected from sample atoms via inelastic scattering."@en .

temgo:SelectedAreaDiffraction a owl:Class ;
    rdfs:label "Selected Area Diffraction"@en ;
    rdfs:subClassOf temgo:ElectronDiffraction ;
    skos:altLabel "SAD"@en,
        "SAED"@en .

temgo:WavelengthDispersiveXRaySpectroscopy a owl:Class ;
    rdfs:label "Wavelength-Dispersive X-ray Spectroscopy"@en ;
    rdfs:subClassOf chameo:Spectroscopy ;
    skos:altLabel "WDS"@en ;
    emmo:elucidation "The primary technique used for Electron Probe Microanalysis (EPMA). It is almost always paired with Energy-Dispersive X-ray Spectroscopy (EDS) to provide highly accurate, non-destructive chemical analysis of microscopic volumes."@en .

chameo:FourDimensionalScanningTransmissionElectronMicroscopy a owl:Class ;
    rdfs:label "4D Scanning Transmission Electron Microscopy"@en ;
    rdfs:subClassOf chameo:TransmissionElectronMicroscopy ;
    skos:altLabel "4DSTEM"@en .

chameo:NanoBeamDiffraction a owl:Class ;
    rdfs:label "Nano-Beam Diffraction"@en ;
    rdfs:subClassOf temgo:ElectronDiffraction ;
    skos:altLabel "NBD"@en ;
    emmo:elucidation "Nano-Beam Diffraction (NBD) uses a fine, near-parallel, nanometer-scale electron probe for acquireing diffraction patterns. It is often combined with the scanning and positioning capabilities of a STEM to acquire local electron diffraction patterns."@en .

chameo:PrecisionElectronDiffraction a owl:Class ;
    rdfs:label "Precession Electron Diffraction"@en ;
    rdfs:subClassOf chameo:FourDimensionalScanningTransmissionElectronMicroscopy ;
    skos:altLabel "SED"@en .

